params {
    // required
    samplesheet   = null   // CSV: sample,gdc_file_id
    fastq_samplesheet = null  // alternative: CSV sample,fastq_1,fastq_2 (Salmon-only mode)
    gdc_token     = null   // path to GDC user token file
    salmon_index  = null   // Salmon index directory or .tar.gz (built from the v49 transcriptome + decoys)
    gene_map      = null   // GENCODE v49 GTF (optionally .gz)

    // optional
    outdir          = 'results'
    num_bootstraps  = 0      // bootstraps make Salmon ~10x slower; use 100 only if you need them
    max_downloads   = 2      // max concurrent gdc-client downloads
    cleanup         = true   // delete BAM/FASTQ after Salmon succeeds
    fused           = false  // one task per sample: download + BAM->FASTQ + Salmon on local disk (use on Google Batch)
    merge_same_sample = false  // allow several rows with the same sample name (merged into one Salmon run)
    skip_rows       = 0      // skip this many data rows at the start of the samplesheet
    limit_rows      = null   // then use only this many rows (null = all)

    // containers: VERIFY these tags exist / pick the versions you want.
    // salmon should match the version used to build the index.
    gdc_container      = 'quay.io/biocontainers/gdc-client:1.6.1--pyhdfd78af_1'
    samtools_container = 'quay.io/biocontainers/samtools:1.20--h50ea8bc_0'
    salmon_container   = 'combinelab/salmon:1.10.1'
    // fused mode needs ONE image with gdc-client + samtools + salmon (see docker/Dockerfile)
    fused_container    = 'us-east1-docker.pkg.dev/amaroq-495623/salmon-workflow/gdc-salmon:1.0'

    // Google Batch
    gcp_project  = 'amaroq-495623'
    gcp_location = 'us-east1'   // keep the bucket, the Batch jobs and the Salmon index in ONE region
    gcp_workdir  = 'gs://garvan-dbgap-controlled/nextflow-work'
}

// Strict bash error handling in every task
process.shell = ['/bin/bash', '-euo', 'pipefail']

process {
    // Retry on common kill / out-of-memory exit codes
    errorStrategy = { task.exitStatus in [137, 140, 143, 50001] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: download {
        container     = params.gdc_container
        cpus          = 2
        memory        = '2 GB'
        time          = '12h'
        // network hiccups: retry on any failure
        errorStrategy = 'retry'
        maxRetries    = 3
    }
    withLabel: samtools {
        container = params.samtools_container
        cpus      = 4
        memory    = '4 GB'
        time      = '12h'
    }
    withLabel: salmon {
        container = params.salmon_container
        cpus      = 12
        memory    = '40 GB'
        time      = '12h'
    }
    withLabel: fused {
        // download -> FASTQ -> Salmon in one task, all on the VM's local disk.
        // Salmon peaked at ~24.5 GB RSS; the whole task needs ~60 GB of disk (BAM + FASTQ + collate temp + index).
        container   = params.fused_container
        cpus        = 16
        memory      = '32 GB'
        disk        = '150 GB'
        machineType = 'e2-standard-16'
        time        = '12h'
    }
    withLabel: light {
        // UNTAR_INDEX and CLEANUP only need coreutils; reuse the samtools image
        container = params.samtools_container
        cpus      = 1
        memory    = '2 GB'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    // Spot VMs on Google Batch. Run with --fused true, e.g.
    //   nextflow run main.nf -profile google_batch --fused true --samplesheet samplesheet.csv \\
    //     --gdc_token ... --salmon_index gs://<bucket>/annotation/salmon_index \\
    //     --gene_map gs://<bucket>/annotation/gencode.v49.genemap.tsv.gz --outdir gs://<bucket>/salmon_results
    google_batch {
        process.executor = 'google-batch'
        workDir          = params.gcp_workdir
        google.project   = params.gcp_project
        google.location  = params.gcp_location
        google.batch.spot             = true
        google.batch.maxSpotAttempts  = 5      // Batch re-runs a task whose Spot VM was reclaimed (exit 50001)
        executor.queueSize            = 20     // concurrent Batch jobs; raise if GDC downloads stay fast
    }
    slurm {
        process.executor = 'slurm'
        // add process.queue = '...' as needed for your cluster
    }
}

timeline.enabled   = true
timeline.overwrite = true
report.enabled     = true
report.overwrite   = true
trace.enabled      = true
trace.overwrite    = true
