// Overrides for running --fused true on the local executor (the 16 vCPU / 64 GB VM):
// two samples at a time, each with 8 CPUs and 28 GB (Salmon peaks at about 25 GB).
// Usage: nextflow run main.nf -c fused_local.config --fused true ...
process {
    withLabel: fused {
        cpus     = 8
        memory   = '28 GB'
        maxForks = 2
    }
}
